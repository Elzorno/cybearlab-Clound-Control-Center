          <label for="roster">Roster file (.xlsx)</label>
          <input id="roster" name="roster" type="file" accept=".xlsx" required />
        </div>
      </div>

      <div class="grid">
        <div>
          <label for="bulk_pw_mode">Password mode</label>
          <select id="bulk_pw_mode" name="bulk_pw_mode">
            <option value="random" selected>Random temp password</option>
            <option value="id">Use ID Number column</option>
          </select>
        </div>
        <div>
          <label>&nbsp;</label>
          <label style="display:flex; gap:0.5rem; align-items:center; margin-top:0.2rem;">
            <input type="checkbox" name="bulk_dry_run" value="1" />
            Dry run (no changes)
          </label>
        </div>
      </div>

      <button type="submit">Run bulk add</button>
    </form>
  </div>

  <div class="card">
    <h2>Maintenance</h2>

    <div class="grid">
      <div>
        <h3>Fix permissions</h3>
        <p class="muted small">Resets perms so nginx can serve student sites reliably.</p>

        <form method="post" action="">
          <input type="hidden" name="csrf_token" value="<?= h(csrf_token()) ?>"/>
          <input type="hidden" name="op" value="fixperms_one"/>
          <label for="u_fix">Username</label>
          <input id="u_fix" name="username" type="text" placeholder="e.g., teststu" required />
          <button type="submit">Fix perms (one)</button>
        </form>

        <form method="post" action="">
          <input type="hidden" name="csrf_token" value="<?= h(csrf_token()) ?>"/>
          <input type="hidden" name="op" value="fixperms_all"/>
          <button type="submit">Fix perms (all)</button>
        </form>
      </div>

      <div>
        <h3>HTTPS for student sites</h3>
        <p class="muted small">Writes/rewrites student vhosts to enforce HTTPS using the wildcard cert.</p>

        <form method="post" action="">
          <input type="hidden" name="csrf_token" value="<?= h(csrf_token()) ?>"/>
          <input type="hidden" name="op" value="https_students_one"/>
          <label for="u_https">Username</label>
          <input id="u_https" name="username" type="text" placeholder="e.g., teststu" required />
          <button type="submit">Enable HTTPS (one)</button>
        </form>

        <form method="post" action="">
          <input type="hidden" name="csrf_token" value="<?= h(csrf_token()) ?>"/>
          <input type="hidden" name="op" value="https_students_all"/>
          <button type="submit">Enable HTTPS (all)</button>
        </form>
      </div>
    </div>

    <div class="hr"></div>

    <div class="grid">
      <div>
        <h3>Admin portal HTTPS</h3>
        <p class="muted small">Issues/renews the cert for <span class="pill">admin.cybearlab.cloud</span> via certbot-nginx.</p>

        <form method="post" action="">
          <input type="hidden" name="csrf_token" value="<?= h(csrf_token()) ?>"/>
          <input type="hidden" name="op" value="https_admin"/>
          <label for="admin_email">Email</label>
          <input id="admin_email" name="admin_email" type="email" placeholder="you@example.com" required />
          <button type="submit">Enable/renew admin HTTPS</button>
        </form>
      </div>

      <div>
        <h3>Wildcard cert maintenance</h3>
        <p class="muted small">Renews/verifies <span class="pill">*.cybearlab.cloud</span> wildcard via Hostinger DNS API.</p>

        <form method="post" action="">
          <input type="hidden" name="csrf_token" value="<?= h(csrf_token()) ?>"/>
          <input type="hidden" name="op" value="https_wildcard"/>
          <label for="admin_email2">Email</label>
          <input id="admin_email2" name="admin_email" type="email" placeholder="you@example.com" required />
          <label for="propagation_seconds">DNS propagation seconds</label>
          <input id="propagation_seconds" name="propagation_seconds" type="number" min="30" max="900" value="180" />
          <button type="submit">Renew/verify wildcard cert</button>
        </form>
      </div>
    </div>

  </div>

  <script>togglePw();</script>
</body>
</html>
