<?php
declare(strict_types=1);

/**
 * ISCS1800 Admin Portal
 * - Protected by Nginx Basic Auth
 * - Executes restricted commands via sudoers (www-data -> root for specific scripts only)
 *
 * Features:
 * - Term-aware operations (optional --term)
 * - Add student (random or manual password)
 * - Reset password (random or manual password)
 * - Disable student
 * - Bulk add via roster upload (.xlsx) -> iscs1800-bulk-add
 * - Maintenance: fix perms, enable HTTPS for students, renew wildcard, enable admin HTTPS
 */

session_start();

function h(string $s): string { return htmlspecialchars($s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); }

function csrf_token(): string {
  if (empty($_SESSION['csrf_token']) || !is_string($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
  }
  return $_SESSION['csrf_token'];
}

function csrf_verify(): bool {
  $t = (string)($_POST['csrf_token'] ?? '');
  return $t !== '' && isset($_SESSION['csrf_token']) && hash_equals((string)$_SESSION['csrf_token'], $t);
}

function valid_username(string $u): bool {
  // Match server scripts: ^[a-z][a-z0-9_-]{2,15}$
  return (bool)preg_match('/^[a-z][a-z0-9_-]{2,15}$/', $u);
}

function valid_term(string $t): bool {
  // Match server scripts: ^[A-Za-z0-9._-]{2,20}$
  return (bool)preg_match('/^[A-Za-z0-9._-]{2,20}$/', $t);
}

function random_password(int $len = 14): string {
  // Avoid quotes/backslashes for shell-safety; still strong enough for temp passwords.
  $alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#%^*_-';
  $max = strlen($alphabet) - 1;
  $out = '';
  for ($i = 0; $i < $len; $i++) {
    $out .= $alphabet[random_int(0, $max)];
  }
  return $out;
}

function run_script(array $argv): array {
  // Build a safe command line. We keep the script path fixed from our allowlist.
  $cmd = 'sudo -n';
  foreach ($argv as $i => $arg) {
    if ($i === 0) {
      // script path
      $cmd .= ' ' . escapeshellcmd($arg);
    } else {
      $cmd .= ' ' . escapeshellarg($arg);
    }
  }
  $cmd .= ' 2>&1';

  $out = [];
  $rc = 0;
  exec($cmd, $out, $rc);
  return ['rc' => $rc, 'output' => implode("\n", $out), 'cmd' => $cmd];
}

function ensure_upload_dir(string $dir): bool {
  if (is_dir($dir)) return true;
  // Try to create; /tmp should allow this for www-data.
  return @mkdir($dir, 0700, true);
}

/**
 * Parse "Report: /path/to/file.csv" from script output.
 */
function extract_report_path(string $out): string {
  if (preg_match('/^Report:\s*(\/[^\s]+\.csv)\s*$/m', $out, $m)) {
    return trim($m[1]);
  }
  return '';
}

/**
 * Parse the bulk report CSV to compute counts and capture failures.
 * Returns:
 *  [
 *    'path' => string,
 *    'counts' => ['OK'=>int,'SKIP'=>int,'FAIL'=>int,'DRYRUN'=>int,'OTHER'=>int],
 *    'failures' => array<array{username:string,email:string,status:string,message:string}>,
 *    'total_rows' => int,
 *    'error' => string
 *  ]
 */
function parse_bulk_report(string $path): array {
  $res = [
    'path' => $path,
    'counts' => ['OK'=>0,'SKIP'=>0,'FAIL'=>0,'DRYRUN'=>0,'OTHER'=>0],
    'failures' => [],
    'total_rows' => 0,
    'error' => '',
  ];

  if ($path === '') {
    $res['error'] = 'No report path found in script output.';
    return $res;
  }

  if (!is_readable($path)) {
    $res['error'] = "Report not readable by portal: {$path}";
    return $res;
  }

  $fh = @fopen($path, 'r');
  if (!$fh) {
    $res['error'] = "Failed to open report: {$path}";
    return $res;
  }

  $header = fgetcsv($fh);
  if (!is_array($header)) {
    fclose($fh);
    $res['error'] = "Report appears empty or invalid CSV: {$path}";
    return $res;
  }

  // Expected header:
  // username,email,temp_password,status,message
  $idx = array_flip($header);

  while (($row = fgetcsv($fh)) !== false) {
    if (!is_array($row) || count($row) < 4) continue;

    $res['total_rows']++;

    $status = trim((string)($row[$idx['status'] ?? 3] ?? ''));
    $username = trim((string)($row[$idx['username'] ?? 0] ?? ''));
    $email = trim((string)($row[$idx['email'] ?? 1] ?? ''));
    $message = (string)($row[$idx['message'] ?? 4] ?? '');

    if ($status === 'OK') {
      $res['counts']['OK']++;
    } elseif ($status === 'SKIP') {
      $res['counts']['SKIP']++;
    } elseif ($status === 'DRYRUN') {
      $res['counts']['DRYRUN']++;
    } elseif (preg_match('/^FAIL/i', $status)) {
      $res['counts']['FAIL']++;
      if (count($res['failures']) < 20) { // cap to avoid huge UI spam
        $res['failures'][] = [
          'username' => $username,
          'email' => $email,
          'status' => $status,
          'message' => $message,
        ];
      }
    } else {
      $res['counts']['OTHER']++;
    }
  }

  fclose($fh);
  return $res;
}

// Scripts (must match sudoers allowlist)
$scripts = [
  'add' => '/usr/local/sbin/iscs1800-add-student',
  'reset' => '/usr/local/sbin/iscs1800-reset-password',
  'disable' => '/usr/local/sbin/iscs1800-disable-student',
  'bulk' => '/usr/local/sbin/iscs1800-bulk-add',
  'fixperms' => '/usr/local/sbin/iscs1800-fix-perms',
  'https_students' => '/usr/local/sbin/iscs1800-enable-https-students',
  'https_admin' => '/usr/local/sbin/iscs1800-enable-https-admin',
  'https_wildcard' => '/usr/local/sbin/iscs1800-enable-https-wildcard',
];

$msg = '';
$err = '';
$details = '';

// Bulk report rendering helpers
$bulkReportPath = '';
$bulkReportSummary = null;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  if (!csrf_verify()) {
    $err = 'Security check failed (CSRF). Refresh and try again.';
  } else {
    $op = (string)($_POST['op'] ?? '');

    // Common inputs
    $term = trim((string)($_POST['term'] ?? ''));
    $termArgv = [];
    if ($term !== '') {
      if (!valid_term($term)) {
        $err = 'Invalid term. Use: ^[A-Za-z0-9._-]{2,20}$';
      } else {
        $termArgv = ['--term', $term];
      }
    }

    if ($err === '') {
      switch ($op) {

        case 'add':
        case 'reset': {
          $user = trim((string)($_POST['username'] ?? ''));
          if (!valid_username($user)) {
            $err = 'Invalid username. Use: ^[a-z][a-z0-9_-]{2,15}$';
            break;
          }

          $mode = (string)($_POST['pw_mode'] ?? 'random');
          $pw = '';
          if ($mode === 'random') {
            $pw = random_password(14);
          } elseif ($mode === 'manual') {
            $pw = (string)($_POST['password'] ?? '');
            if (strlen($pw) < 10) {
              $err = 'Manual password must be at least 10 characters.';
              break;
            }
          } else {
            $err = 'Invalid password mode.';
            break;
          }

          $script = $scripts[$op];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = array_merge([$script], $termArgv, [$user, $pw]);
          $res = run_script($argv);

          if ($res['rc'] === 0) {
            $msg = ($op === 'add' ? 'Add student' : 'Reset password') . " succeeded for " . h($user) . ".";
            $details = "TEMP PASSWORD: " . h($pw) . "\n\n" . h($res['output']);
          } else {
            $err = ($op === 'add' ? 'Add student' : 'Reset password') . " failed for " . h($user) . " (exit {$res['rc']}).";
            $details = h($res['output']);
          }
          break;
        }

        case 'disable': {
          $user = trim((string)($_POST['username'] ?? ''));
          if (!valid_username($user)) {
            $err = 'Invalid username. Use: ^[a-z][a-z0-9_-]{2,15}$';
            break;
          }

          $script = $scripts['disable'];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = array_merge([$script], $termArgv, [$user]);
          $res = run_script($argv);

          if ($res['rc'] === 0) {
            $msg = "Disable student succeeded for " . h($user) . ".";
            $details = h($res['output']);
          } else {
            $err = "Disable student failed for " . h($user) . " (exit {$res['rc']}).";
            $details = h($res['output']);
          }
          break;
        }

        case 'bulk': {
          // Term is required for bulk
          if ($term === '') {
            $err = 'Term is required for bulk add.';
            break;
          }

          $pwMode = (string)($_POST['bulk_pw_mode'] ?? 'random');
          if ($pwMode !== 'random' && $pwMode !== 'id') {
            $err = 'Invalid bulk password mode.';
            break;
          }

          $dryRun = isset($_POST['bulk_dry_run']) ? true : false;

          if (!isset($_FILES['roster']) || !is_array($_FILES['roster'])) {
            $err = 'Roster file upload missing.';
            break;
          }

          $f = $_FILES['roster'];
          if (($f['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK) {
            $err = 'Upload failed. Error code: ' . (string)($f['error'] ?? 'unknown');
            break;
          }

          $name = (string)($f['name'] ?? '');
          $tmp = (string)($f['tmp_name'] ?? '');
          if ($tmp === '' || !is_uploaded_file($tmp)) {
            $err = 'Upload temp file invalid.';
            break;
          }

          // Basic extension check (openpyxl will validate structure anyway)
          if (!preg_match('/\.xlsx$/i', $name)) {
            $err = 'Roster must be an .xlsx file.';
            break;
          }

          $uploadDir = '/tmp/iscs1800-rosters';
          if (!ensure_upload_dir($uploadDir)) {
            $err = "Server cannot create upload dir: $uploadDir";
            break;
          }

          $stamp = date('Ymd-His');
          $dest = $uploadDir . '/roster_' . preg_replace('/[^A-Za-z0-9._-]/', '_', $term) . '_' . $stamp . '.xlsx';

          if (!move_uploaded_file($tmp, $dest)) {
            $err = 'Failed to store uploaded roster on server.';
            break;
          }

          // Readable by root; keep it from being world-readable in /tmp
          @chmod($dest, 0600);

          $script = $scripts['bulk'];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = [$script, '--term', $term, '--file', $dest, '--password-mode', $pwMode];
          if ($dryRun) $argv[] = '--dry-run';

          $res = run_script($argv);

          // Always try to parse report even if rc != 0 (partial runs can still produce it)
          $bulkReportPath = extract_report_path($res['output']);
          if ($bulkReportPath !== '') {
            $bulkReportSummary = parse_bulk_report($bulkReportPath);
          }

          $baseDetails = "Uploaded roster stored at: " . h($dest) . "\n\n" . h($res['output']);

          // Determine user-facing status:
          // - If script itself failed (rc != 0), show error.
          // - If script succeeded but report contains FAIL rows, show warning-style error.
          // - Otherwise show success.
          if ($res['rc'] !== 0) {
            $err = "Bulk add failed (term " . h($term) . ", exit {$res['rc']}).";
            $details = $baseDetails;
          } else {
            // Script rc==0. Now check report failures (if we have it).
            $failCount = 0;
            if (is_array($bulkReportSummary) && isset($bulkReportSummary['counts']['FAIL'])) {
              $failCount = (int)$bulkReportSummary['counts']['FAIL'];
            }

            if ($failCount > 0) {
              $err = "Bulk add completed with errors (term " . h($term) . ").";
              $details = $baseDetails;
            } else {
              $msg = "Bulk add completed (term " . h($term) . ").";
              $details = $baseDetails;
            }
          }

          break;
        }

        case 'fixperms_one':
        case 'https_students_one': {
          $user = trim((string)($_POST['username'] ?? ''));
          if (!valid_username($user)) {
            $err = 'Invalid username. Use: ^[a-z][a-z0-9_-]{2,15}$';
            break;
          }

          $script = ($op === 'fixperms_one') ? $scripts['fixperms'] : $scripts['https_students'];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = [$script, $user];
          $res = run_script($argv);

          if ($res['rc'] === 0) {
            $msg = ($op === 'fixperms_one' ? 'Fix perms' : 'Enable HTTPS (student)') . " succeeded for " . h($user) . ".";
            $details = h($res['output']);
          } else {
            $err = ($op === 'fixperms_one' ? 'Fix perms' : 'Enable HTTPS (student)') . " failed for " . h($user) . " (exit {$res['rc']}).";
            $details = h($res['output']);
          }
          break;
        }

        case 'fixperms_all':
        case 'https_students_all': {
          $script = ($op === 'fixperms_all') ? $scripts['fixperms'] : $scripts['https_students'];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = [$script, '--all'];
          $res = run_script($argv);

          if ($res['rc'] === 0) {
            $msg = ($op === 'fixperms_all' ? 'Fix perms (all)' : 'Enable HTTPS for students (all)') . " succeeded.";
            $details = h($res['output']);
          } else {
            $err = ($op === 'fixperms_all' ? 'Fix perms (all)' : 'Enable HTTPS for students (all)') . " failed (exit {$res['rc']}).";
            $details = h($res['output']);
          }
          break;
        }

        case 'https_admin': {
          $email = trim((string)($_POST['admin_email'] ?? ''));
          if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $err = 'Valid email is required for admin HTTPS.';
            break;
          }

          $script = $scripts['https_admin'];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = [$script, '--email', $email];
          $res = run_script($argv);

          if ($res['rc'] === 0) {
            $msg = "Admin HTTPS enabled/renewed.";
            $details = h($res['output']);
          } else {
            $err = "Admin HTTPS failed (exit {$res['rc']}).";
            $details = h($res['output']);
          }
          break;
        }

        case 'https_wildcard': {
          $email = trim((string)($_POST['admin_email'] ?? ''));
          if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $err = 'Valid email is required for wildcard renewal.';
            break;
          }

          $prop = trim((string)($_POST['propagation_seconds'] ?? '180'));
          if (!preg_match('/^[0-9]{2,4}$/', $prop)) {
            $err = 'Propagation seconds must be numeric (e.g., 180, 300).';
            break;
          }

          $script = $scripts['https_wildcard'];
          if (!is_executable($script)) {
            $err = "Script not executable: " . h($script);
            break;
          }

          $argv = [$script, '--email', $email, '--propagation-seconds', $prop];
          $res = run_script($argv);

          if ($res['rc'] === 0) {
            $msg = "Wildcard cert renewed/verified.";
            $details = h($res['output']);
          } else {
            $err = "Wildcard renewal failed (exit {$res['rc']}).";
            $details = h($res['output']);
          }
          break;
        }

        default:
          $err = 'Invalid operation.';
      }
    }
  }
}
